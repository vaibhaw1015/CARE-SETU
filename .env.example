# =============================================================
# CareSetu — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file — it contains secret API keys.
# =============================================================

# ── Supabase (Frontend) ──────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Groq AI (for AI Doctor chatbot) ─────────────────────────
# Get your key from: https://console.groq.com/keys
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# ── UPI Payment Config ───────────────────────────────────────
VITE_UPI_ID=caresetu@upi
VITE_UPI_NAME=CareSetu Health Services
VITE_ENABLE_MOCK_PAYMENT=true

# ── Supabase Edge Function Secrets ──────────────────────────
# Set these in the Supabase Dashboard → Project Settings → Edge Functions
# or via CLI: supabase secrets set GROQ_API_KEY=xxx
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# GROQ_MODEL=qwen/qwen3-27b
